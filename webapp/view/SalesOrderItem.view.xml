<mvc:View
    controllerName="fiori.y2026.sapfioritraining2026.controller.SalesOrderItem"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    core:require="{
        Formatter: 'fiori/y2026/sapfioritraining2026/model/formatter'}">
    <Page id="pageSalesOrderItem" title="{ parts:['i18n>item.pageTitle', 'salesOrders>SalesOrder', 'salesOrders>SalesOrderItem'],
                                             formatter:'jQuery.sap.formatMessage'}">
        <footer>
            <OverflowToolbar id="SOItemFooterToolBar">
                <Button id="SOItemBackButton" press=".onBackButton" type="Back" text="{i18n>item.backButton}"></Button>
            </OverflowToolbar>
        </footer>                                             
        <form:SimpleForm id="SOItemGeneralInfoForm"
            editable="false"
            layout="ColumnLayout"
            title="{i18n>detail.generalInfo.title}"
            columnsXL="2"
            columnsL="2"
            columnsM="1">
            <form:content>
                <Label id="SOItemSalesOrderLabel"
                    text="{i18n>detail.generalInfo.salesOrderLabel}"/>
                <Text id="SOItemSalesOrderText"
                    text="{salesOrders>SalesOrder}"/>
                <Label id="SOItemSalesOrderItemLabel"
                    text="{i18n>item.salesOrderItem}"/>
                <Text id="SOItemSalesOrderItemText"
                    text="{salesOrders>SalesOrderItem}"/>
                <Label id="SOItemCreationDateL" text="{i18n>item.PricingDate}"/>
                <Text id="SOItemCreationDate" 
                    text="{path:'salesOrders>PricingDate',
                        formatter:'Formatter.formatDate'
                }"/>
                <Label id="SOItemDelStatusL" text="{i18n>detail.deliveryInfo.deliveryStatusLabel}"/>
                <Text id="SOItemDelStatus" 
                    text="{path:'salesOrders>DeliveryStatus',
                        formatter:'Formatter.overallDeliveryStatusText'}"/>
            </form:content>
        </form:SimpleForm>

        <form:SimpleForm id="SOItemMaterial"
            editable="false"
            layout="ColumnLayout"
            title="{i18n>item.Material.title}"
            columnsXL="2"
            columnsL="2"
            columnsM="1">
            <form:content>
               <Label id="SOItemMaterialLabel"
                    text="{i18n>detail.table.Mat}"/>
                <Text id="SOItemMaterialText"
                    text="{salesOrders>Material}"/>
               <Label id="SOItemDescrLabel"
                    text="{i18n>detail.table.Tx}"/>
                <Text id="SOItemDescrText"
                    text="{salesOrders>SalesOrderItemText}"/>
            </form:content>
        </form:SimpleForm>
    </Page>
</mvc:View>