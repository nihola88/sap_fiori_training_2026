<mvc:View xmlns:webc="sap.ui.core.webc" xmlns:fb="sap.ui.comp.filterbar" xmlns:core="sap.ui.core" xmlns:tnt="sap.tnt" 
    controllerName="fiori.y2026.sapfioritraining2026.controller.LandingView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    core:require="{
        Formatter: 'fiori/y2026/sapfioritraining2026/model/formatter',
        Currency: 'sap/ui/model/type/Currency'
    }">
    <Page id="page" title="{i18n>title}">
    <Panel id="baseComponentsPanel" expandable="true" expanded="true" headerText="{i18n>baseComponentsPanelHeader}">
        <HBox id="baseComponentsPanelHBox1" alignItems="Center" width="100%">
            <Text id="baseComponentsPanelText1" width="50%" class="sapUIMediumMarginEnd" text="{i18n>ExampleText}"/>
            <VBox id="VBox1" height="100%">
            <Button id= "baseComponentsPanelButtonToast" 
                    text="{i18n>ToastButtonText}" 
                    press=".onToastButtonPress" 
                    type="Emphasized" icon="sap-icon://addresses"
                    />
                    <Button id ="MessageBoxButton" class="sapUiSmallMarginBegin"
                    text="{i18n>MessageBoxButtonText}"
                    press=".onMessageBoxButtonPress"
                    tooltip="{i18n>MessageBoxButtonTooltip}"
                    />
                    <HBox id="HBStepInput" class="baseComponentsPanelButtonToast" alignContent="Start" alignItems="Center" width="100%">
                        <StepInput id="StepInputTest" change=".onStepInputChange" min="0" max="10" description="Step Input"></StepInput>
                        <Text id="stepInputDescr" text="{i18n>StepInputDescription}" ></Text>
                    </HBox>
            </VBox>
        </HBox>
        <Table id="tab1" items="{myModel>/}" class="sapUiResponsiveMargin" inset="false" width="100%"
            headerText="HeaderTest"
            visible="false"
            >
            <columns>
                <Column id="col1">
                    <Text id="Field1" text="Var1Head"></Text>
                </Column>
                <Column id="col2">
                    <Text id="Field2" text="Var2"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem id="colListTab1">
                    <cells>
                        <Text id="textField1" text="{myModel>var1}"/>
                        <Text id="textField2" text="{myModel>var2}"/>
                    </cells>
                </ColumnListItem>
            </items>

        </Table>
    </Panel>
    <Panel id="bindingPanel" expandable="true" expanded="true" headerText="{i18n>Bindings}">
        <HBox id="bindigsPanelHbox1" alignItems="Center" alignContent="Center">
            <Label id="bindingsPanelLabel" class="sapUiMediumMarginEnd" text="{i18n>BindingsPanelLabel}" textAlign="Center"></Label>
            <Input id="bindingsPanelInput" class="sapUiMediumMarginEnd" width="10rem" value="{bindingsDemo>/inputValue}" textAlign="Center"></Input>
            <Button id="bindingPanelButtonSayHello" text="{i18n>SayHelloText}" tooltip="{i18n>SayHelloTooltip}" type="Emphasized" press=".onSayHello" />
        </HBox>
    </Panel>
    <Panel id="SommaPanel" headerText="{i18n>SommaPanelHeader}" expandable="true" expanded="true">
        <VBox id="VBoxSomma">
            <HBox id="HBoxNum1">
                <Label id="Label1" text="{i18n>Num1}" width="5rem" textAlign="Center"></Label>
                <Input id="num1" value="{/num1}" width="15rem" type="Number" textAlign="Center"></Input>
            </HBox>
            <HBox id="HBoxNum2">
                <Label id="Label2" text="{i18n>Num2}" width="5rem" textAlign="Center"></Label>
                <Input id="num2" value="{/num2}" width="15rem" type="Number" textAlign="Center"></Input>
            </HBox>
            <Button id="sommaButton" text="{i18n>sommaButton}" press=".onSommaButton"></Button>
            <Text id="sommaResult" text="{parts:['i18n>SommaResult', '/sommaResult'], formatter: 'jQuery.sap.formatMessage'}"></Text>
        </VBox>
    </Panel>
    <Panel id= "dialogPanel" expandable="true" headerText="{i18n>dialogPanel.title}" >
        <headerToolbar>
            <tnt:ToolHeader id="header" style="Clear" >
                <core:Icon id="iconHeaderDialogPanel" color="Positive" src="sap-icon://message-popup"></core:Icon>
                <Title id="titleHeaderDialogPanel" text="{i18n>dialogPanel.title}" textAlign="Center" width="90%"></Title>
            </tnt:ToolHeader>
        </headerToolbar>
        <infoToolbar>
            <Toolbar id="dialogPanelInfoToolbar" >
                <Text id="dialogPanelInfoToolbarText" text="Pannello dialoghi" textAlign="Begin"></Text>
            </Toolbar>
        </infoToolbar>
        <Button id="dialogBtnOpen" text="{i18n>dialogPanel.openBtn}" icon="sap-icon://bell" press=".onOpenDialog"
                class="sapUiSmallMarginBeginEnd"></Button>
        <Button id="insertUserBtn" text="{i18n>dialogPanel.insertUsr}"
                press=".onOpenDialogUsr"
                class="sapUiSmallMarginBeginEnd" icon="sap-icon://account"
        ></Button>

    </Panel>
    <Panel id="listPanel" expandable="true" expanded="false" headerText="{i18n>listPanel.header}">
        <List id="salesOrderList" items="{salesOrders>/A_SalesOrder}" 
             headerText="{i18n>listPanel.headerText}"
             growing="true"
             growingThreshold="20"
             width="auto"
            >
            <headerToolbar>
                <OverflowToolbar id="salesOrdersToolbar" class="sapUiSmallMargin" height="auto">
                    <!--<VBox id="salesOrdersHeaderVBox">-->
                        <Title id="salesOrdersTitle" text="{i18n>listPanel.headerText}"/>
                        <ToolbarSpacer id="salesOrdHeaderSpacer"/>
                        <SearchField id="salesOrdersSearchField" 
                            search=".onSearchSO" liveChange=".onSearchSO" width="50%">
                        </SearchField>
                    <!--</VBox>-->
                </OverflowToolbar>
            </headerToolbar>
            <items>
                <ObjectListItem id="salesOrdersObjectListItem"  type="Navigation" press=".onSalesOrderDetail"
                                title="{salesOrders>SalesOrder}"
                                number="{
                                            parts:['salesOrders>TotalNetAmount',
                                                    'salesOrders>TransactionCurrency'],
                                            type: 'Currency',
                                            formatOptions:  {showMeasure: true }
                                         }"
                                numberUnit="{salesOrders>TransactionCurrency}">
                    <ObjectAttribute id="salesOrderObjAttribute"
                                     text="{i18n>listPanel.createdBy} {salesOrders>CreatedByUser}"/>
                    <firstStatus>
                        <ObjectStatus id="salesOrderObjectStatus"
                            text="{path:'salesOrders>OverallDeliveryStatus',
                                   formatter:'Formatter.overallDeliveryStatusText.bind($controller)'
                                  }"
                            state="{
                                    path:'salesOrders>OverallDeliveryStatus',
                                    formatter:'Formatter.overallDeliveryStatusState.bind($controller)'
                                  }"/>
                    </firstStatus>
                </ObjectListItem>
            </items>
        </List>
    </Panel>
    <Panel id="panelResponsiveTab" expandable="true" expanded="false" headerText="{i18n>respTab.header}">

        <content>
        <fb:FilterBar id="respTableFiltBar" useToolbar="false" search=".onSearchFilterBar">
            <fb:filterGroupItems> 
                <fb:FilterGroupItem id="filter1" name="CreatedBy" label="Created By" groupName="Group1" visibleInFilterBar="true">
                    <fb:control>
                        <MultiComboBox id="comboBox1" name="CreatedBy" items="{filterbarModel>/createdBy}" selectionChange=".onSelectionChange" showClearIcon="true"
                            showSelectAll="true" >
                            <items>
                                <core:Item id="cb1Item" key="{filterbarModel>name}" text="{filterbarModel>name}"></core:Item>
                            </items>
                        </MultiComboBox>
                    </fb:control>
                 </fb:FilterGroupItem>
                <fb:FilterGroupItem id="filter2" name="SODate" label="Sales Ord. Date" groupName="Group1" visibleInFilterBar="true">
                    <fb:control>
                        <DateRangeSelection id="dateRangeFilter" displayFormat="dd/MM/yyyy"
                            showCurrentDateButton="true" showFooter="true" change=".handleDatePickChange"/>
                    </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem id="salesOrgFilt" label="Sales Organization" name="salesOrg" groupName="Group1" visibleInFilterBar="true" >
                    <fb:control>
                        <Input id="salesOrgFiltInput" width="20rem" showValueHelp="true" valueHelpRequest=".onSalesOrgFiltVHReq" placeholder="Sales Organization" valueLiveUpdate="true"
                            ></Input>
                    </fb:control>
                </fb:FilterGroupItem>
           </fb:filterGroupItems>
        </fb:FilterBar>
            <Table id="respTab" items="{salesOrders>/A_SalesOrder}" growing="true">
                <columns>
                    <Column id="salesOrdC" width="10%"><Label id="salesOrdLabel" text="{i18n>respTabCol.salesOrd}"></Label></Column>
                    <Column id="SOTypC" width="10%"><Label id="SOTypLabel" text="{i18n>respTabCol.SOTyp}"></Label></Column>
                    <Column id="SODatC" width="15%"><Label id="SODatLabel" text="{i18n>respTabCol.SODat}"></Label></Column>
                    <Column id="SOSOrgC" width="10%"><Label id="SOSOrgLabel" text="{i18n>respTabCol.SOSOrg}"></Label></Column>
                    <Column id="CreatedByUserC" width="40%"><Label id="CreatedByUserLabel" text="{i18n>respTabCol.CreatedByUser}"></Label></Column>

                </columns>

                <items>
                    <ColumnListItem id="respTabColList" highlight="None">
                        <Text id="salesOrdT" text="{salesOrders>SalesOrder}"></Text>
                        <Text id="SOTypT" text="{salesOrders>SalesOrderType}"></Text>
                        <Text id="SODatT" text="{path:'salesOrders>SalesOrderDate',
                                                 type:'sap.ui.model.odata.type.Date',
                                                 formatter:'Formatter.formatDate.bind($controller)',
                                                 formatOptions:{pattern: 'dd/mm/yyyy'}}"></Text>
                        <Text id="SOSOrgT" text="{salesOrders>SalesOrganization}"></Text>
                        <Text id="CreatedByUserT" text="{salesOrders>CreatedByUser}"></Text>
                    </ColumnListItem>
                </items>
            
                </Table>
        </content>
    </Panel>
    </Page>
</mvc:View>