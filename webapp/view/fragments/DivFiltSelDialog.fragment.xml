<core:FragmentDefinition id="divisionFiltFragment" xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog id="VHDivision" initialFocus="SearchField" noDataText="No Divisions!" title="Select Division"
        items="{divisions>}"
    >
    <items>
        <StandardListItem 
            id="VHDivisionList" 
            description="{divisions>_Text/DivisionName}"
            title="{divisions>Division}"
            iconInset="false"
            type="Active"
        />
    </items>
    </SelectDialog>
</core:FragmentDefinition>