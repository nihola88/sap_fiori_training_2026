<core:FragmentDefinition id="divisionFiltFragment" xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog id="VHSalesOrg" initialFocus="List" noDataText="No Sales Organizations!" title="Select Division"
        items="{path: 'salesOrgs>/A_SalesOrganization', parameters: {expand:'to_Text'}}"  confirm=".onSelectSalesOrg"
    >
    <items>
        <StandardListItem 
            id="VHSalesOrgList" 
            description="{salesOrgs>SalesOrganization}"
            title="{parts: ['salesOrgs>SalesOrganization', 'salesOrgs>to_Text/SalesOrganizationName'],
                    formatter:'.formatter.manageSalesOrg'
            }"
            iconInset="false"
            type="Active"
        />
    </items>
    </SelectDialog>
</core:FragmentDefinition>