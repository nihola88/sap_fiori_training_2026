{
  "_version": "1.89.0",
  "sap.app": {
    "id": "fiori.y2026.sapfioritraining2026",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "info": "{{tileTitle}}",
    "shortTitle": "testManifest",
    "subTitle": "{{tileTitle}}",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription2}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.32.0",
      "toolsId": "e5630de5-8683-4160-b381-9d1d130d50ff"
    },
    "crossNavigation": {
      "inbounds": {
        "ZFIORI_2026-open": {
          "semanticObject": "ZFIORI_2026",
          "action": "open",
          "title": "{{ZFIORI_2026-open.flpTitle}}",
          "subTitle": "{{ZFIORI_2026-open.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "API_SALES_ORDER_ANNO_MDL": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='API_SALES_ORDER_ANNO_MDL',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/API_SALES_ORDER_ANNO_MDL.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/API_SALES_ORDER_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [
            "API_SALES_ORDER_ANNO_MDL"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "API_SALESORGANIZATION_ANNO_MDL": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='API_SALESORGANIZATION_ANNO_MDL',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/API_SALESORGANIZATION_SRV/API_SALESORGANIZATION_ANNO_MDL.xml"
        }
      },
      "API_SALESORGANIZATION_SRV": {
        "uri": "/sap/opu/odata/sap/API_SALESORGANIZATION_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [
            "API_SALESORGANIZATION_ANNO_MDL"
          ],
          "localUri": "localService/API_SALESORGANIZATION_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "fiori.y2026.sapfioritraining2026.i18n.i18n"
        }
      },
      "salesOrders_old": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/2-salesOrders.json"
      },
      "salesOrders": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "salesOrgs": {
        "dataSource": "API_SALESORGANIZATION_SRV",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "fiori.y2026.sapfioritraining2026.view",
        "async": true,
        "viewPath": "fiori.y2026.sapfioritraining2026.view"
      },
      "routes": [
        {
          "name": "RouteLandingView",
          "pattern": ":?query:",
          "target": [
            "TargetLandingView"
          ]
        },
        {
          "name": "RouteSalesOrderDetail",
          "pattern": "salesOrder/{SalesOrderPath}",
          "target": [
            "TargetSalesOrderDetail"
          ]
        },
        {
          "name": "RouteSalesOrderItem",
          "pattern": "salesOrder/item/{SalesOrderPath}",
          "target": [
            "TargetSalesOrderItem"
          ]
        }
      ],
      "targets": {
        "TargetLandingView": {
          "id": "LandingView",
          "name": "LandingView"
        },
        "TargetSalesOrderDetail": {
          "id": "pageSalesOrderDetail",
          "name": "SalesOrderDetail"
        },
        "TargetSalesOrderItem": {
          "id": "pageSalesOrderItem",
          "name": "SalesOrderItem"
        }
      }
    },
    "rootView": {
      "viewName": "fiori.y2026.sapfioritraining2026.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
